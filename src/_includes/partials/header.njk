        <nav class="site-header__nav" aria-label="Main navigation">
            <ul class="site-header__nav-list">
                <li class="site-header__nav-item">
                    <a class="site-header__nav-link" href="/about/" {% if page.url=="/about/" %}aria-current="page" {%
                        endif %}>
                        About
                    </a>
                </li>

                <li class="site-header__nav-item">
                    <a class="site-header__nav-link" href="/services/" {% if page.url=="/services/"
                        %}aria-current="page" {% endif %}>
                        Services
                    </a>
                </li>

                <li class="site-header__nav-item">
                    <a class="site-header__nav-link" href="/industries/" {% if page.url=="/industries/"
                        %}aria-current="page" {% endif %}>
