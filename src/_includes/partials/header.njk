<header class="site-header">
    <div class="site-header__inner">
        <a class="site-header__logo" href="/index/" aria-label="Company Name home">
            <img class="site-header__logo-image" src="/public/images/logo.png" alt="Company Name, LLC">
        </a>

        <nav class="site-header__nav" aria-label="Main navigation">
            <ul class="site-header__nav-list">

                {% for item in site.navigation %}
                <li class="site-header__nav-item">
                    <a class="site-header__nav-link" href="{{ item.url }}" {% if page.url==item.url %}
                        aria-current="page" {% endif %}>
                        {{ item.label }}
                    </a>
                </li>
                {% endfor %}
            </ul>
        </nav>

        <button class="site-header__menu-toggle" type="button" aria-label="Open menu" aria-controls="mobile-menu"
            aria-expanded="false">
            <span class="site-header__menu-line"></span>
            <span class="site-header__menu-line"></span>
            <span class="site-header__menu-line"></span>
        </button>
    </div>

    <div class="site-header__mobile-menu" id="mobile-menu" role="dialog" aria-modal="true"
        aria-label="Mobile navigation" hidden>
        <div class="site-header__mobile-panel">
            <div class="site-header__mobile-top">
                <button class="site-header__mobile-close" type="button" aria-label="Close menu">
                    <svg class="site-header__mobile-close-icon" viewBox="0 0 24 24" aria-hidden="true">
                        <path d="M6 6l12 12"></path>
                        <path d="M18 6L6 18"></path>
                    </svg>
                </button>
            </div>

            <div class="site-header__mobile-content container--wide">
                <nav class="site-header__mobile-nav" aria-label="Mobile navigation">
                    <ul class="site-header__mobile-nav-list">
                        {% for item in site.navigation %}
                            <li>
                                <a
                                    class="site-header__mobile-nav-link"
                                    href="{{ item.url }}"
                                    {% if page.url == item.url %}
                                        aria-current="page"
                                    {% endif %}
                                >
                                    {{ item.label }}
                                </a>
                            </li>
                        {% endfor %}
                    </ul>
                </nav>
            </div>
        </div>
    </div>
</header>