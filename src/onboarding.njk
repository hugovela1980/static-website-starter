---
layout: layouts/base.njk
title: Onboarding | Company Name
permalink: /onboarding/
---

<div class="onboarding-page">
    <section class="page-hero page-hero--onboarding" aria-labelledby="onboarding-hero-title">
        <div class="onboarding-hero__inner container">
            <div class="onboarding-hero__content">
                <h1 class="onboarding-hero__title" id="onboarding-hero-title"> Our Onboarding Process </h1>
                <p class="onboarding-hero__text"> A simple, structured approach designed to deliver clarity, strategy,
                    and results. </p>
            </div>
        </div>
    </section>

    <section class="onboarding-flow" aria-labelledby="onboarding-flow-title">
        <div class="onboarding-flow__inner container">
            <div class="onboarding-flow__layout">
                <div class="onboarding-flow__intro">
                    <h2 class="onboarding-flow__heading" id="onboarding-flow-title">
                        Our Process.
                        <span>Your Success.</span>
                    </h2>

                    <p class="onboarding-flow__lead">
                        A proven workflow to bring clarity, drive performance, and support your goals.
                    </p>
                </div>

                <svg class="onboarding-flow__connectors" data-flow-connectors aria-hidden="true" focusable="false">
                    <defs>
                        <marker id="onboarding-flow-arrowhead" class="onboarding-flow__connector-marker"
                            markerWidth="34" markerHeight="34" refX="4" refY="17" orient="auto"
                            markerUnits="userSpaceOnUse">
                            <path class="onboarding-flow__connector-arrowhead" d="M 4 4 L 30 17 L 4 30 Z"></path>
                        </marker>
                    </defs>

                    <g data-flow-connector-layer></g>
                </svg>

                <article class="onboarding-flow__card onboarding-flow__card--one" data-flow-node="step-1">
                    <div class="onboarding-flow__number" aria-hidden="true">1</div>

                    <div class="site-icon onboarding-flow__icon onboarding-flow__icon--discovery" aria-hidden="true">
                    </div>

                    <div class="onboarding-flow__content">
                        <h3 class="onboarding-flow__title">
                            Discovery <br>
                            &amp; Assessment
                        </h3>

                        <div class="onboarding-flow__text">
                            <p class="onboarding-flow__description">
                                We get to know your business, goals, challenges, and priorities so we can understand
                                where you are today and where you want to go.
                            </p>

                            <p class="onboarding-flow__outcome">
                                <strong>Outcome:</strong> Clear understanding of your business and objectives.
                            </p>
                        </div>
                    </div>
                </article>

                <article class="onboarding-flow__card onboarding-flow__card--two" data-flow-node="step-2">
                    <div class="onboarding-flow__number" aria-hidden="true">2</div>

                    <div class="site-icon onboarding-flow__icon onboarding-flow__icon--review" aria-hidden="true"></div>

                    <div class="onboarding-flow__content">
                        <h3 class="onboarding-flow__title">
                            Financial <br>
                            Review
                        </h3>

                        <div class="onboarding-flow__text">
                            <p class="onboarding-flow__description">
                                We review your financial statements, reporting processes, cash flow trends, key metrics,
                                and accounting systems.
                            </p>

                            <p class="onboarding-flow__outcome">
                                <strong>Outcome:</strong> Visibility into performance, risks, gaps, and opportunities.
                            </p>
                        </div>
                    </div>
                </article>

                <article class="onboarding-flow__card onboarding-flow__card--three" data-flow-node="step-3">
                    <div class="onboarding-flow__number" aria-hidden="true">3</div>

                    <div class="site-icon onboarding-flow__icon onboarding-flow__icon--roadmap" aria-hidden="true">
                    </div>

                    <div class="onboarding-flow__content">
                        <h3 class="onboarding-flow__title">
                            Build the Roadmap
                        </h3>

                        <div class="onboarding-flow__text">
                            <p class="onboarding-flow__description">
                                We develop a prioritized action plan focused on the areas that will create the greatest
                                impact for your business.
                            </p>

                            <p class="onboarding-flow__outcome">
                                <strong>Outcome:</strong> A practical roadmap with clear priorities and next steps.
                            </p>
                        </div>
                    </div>
                </article>

                <article class="onboarding-flow__card onboarding-flow__card--four" data-flow-node="step-4">
                    <div class="onboarding-flow__number" aria-hidden="true">4</div>

                    <div class="site-icon onboarding-flow__icon onboarding-flow__icon--support" aria-hidden="true">
                    </div>

                    <div class="onboarding-flow__content">
                        <h3 class="onboarding-flow__title">
                            Implementation &amp; Support
                        </h3>

                        <div class="onboarding-flow__text">
                            <p class="onboarding-flow__description">
                                We execute the plan and provide financial leadership, reporting, guidance, and support
                                for key business decisions.
                            </p>

                            <p class="onboarding-flow__outcome">
                                <strong>Outcome:</strong> Better decision-making, stronger performance, and measurable
                                progress.
                            </p>
                        </div>
                    </div>
                </article>

                <article class="onboarding-flow__card onboarding-flow__card--five" data-flow-node="step-5">
                    <div class="onboarding-flow__number" aria-hidden="true">5</div>

                    <div class="site-icon onboarding-flow__icon onboarding-flow__icon--partnership" aria-hidden="true">
                    </div>

                    <div class="onboarding-flow__content">
                        <h3 class="onboarding-flow__title">
                            Ongoing Partnership
                        </h3>

                        <div class="onboarding-flow__text">
                            <p class="onboarding-flow__description">
                                As your business evolves, we adjust support to match your needs, priorities, and
                                opportunities.
                            </p>

                            <p class="onboarding-flow__outcome">
                                <strong>Outcome:</strong> CFO-level expertise that scales with your business.
                            </p>
                        </div>
                    </div>
                </article>

                <div class="onboarding-flow__goal">
                    <div class="site-icon onboarding-flow__goal-icon" data-flow-node="goal-target" aria-hidden="true">
                    </div>

                    <div class="onboarding-flow__goal-content">
                        <p class="onboarding-flow__goal-title">
                            Your goals. <span>Our commitment.</span>
                        </p>

                        <p class="onboarding-flow__goal-text">
                            Together, we create lasting value.
                        </p>
                    </div>
                </div>
            </div>
        </div>
    </section>
</div>

